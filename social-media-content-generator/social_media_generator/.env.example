# Copy to .env (or just export these) before running the pipeline.

# --- Claude / script (required) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-4-8
# SMG_MODEL=claude-opus-4-8

# --- ElevenLabs / voice (required for video) ---
ELEVENLABS_API_KEY=...
# The voice to speak with — use a cloned voice id for "your voice"
ELEVENLABS_VOICE_ID=...
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- HeyGen / avatar video (required for video) ---
HEYGEN_API_KEY=...
HEYGEN_AVATAR_ID=...
# HEYGEN_AVATAR_STYLE=normal
# SMG_VIDEO_WIDTH=1280
# SMG_VIDEO_HEIGHT=720
